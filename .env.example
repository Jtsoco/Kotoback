DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me

# Postgres (used when USE_SQLITE is not "1")
POSTGRES_DB=kotoback_dev
POSTGRES_USER=kotoback
POSTGRES_PASSWORD=kotoback
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Set to 1 if you want SQLite instead (rarely recommended)
USE_SQLITE=0

REDIS_HOST=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
MEDIA_ROOT=
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
EPUB_MAX_UPLOAD_SIZE=26214400
